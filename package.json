{
  "name": "sohail-studio",
  "version": "0.1.0",
  "description": "Local-first AI engineering workspace",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test tsx test_runtime_evidence.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
